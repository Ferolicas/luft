[Unit]
Description=Activa LUFT en luft.com.co cuando el dominio apunte a este servidor
After=network-online.target nginx.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/luft-activar-dominio
StandardOutput=append:/var/log/luft-dominio.log
StandardError=append:/var/log/luft-dominio.log
TimeoutStartSec=1800

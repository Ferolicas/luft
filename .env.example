# Aplicación
NODE_ENV=production
APP_URL=https://luft.restaurar.co
LEGAL_DOCUMENTS_READY=false
WEB_PORT=4002
API_PORT=4003
SCORING_PORT=4004
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_PATH=/socket.io
API_INTERNAL_URL=http://127.0.0.1:4003
SCORING_INTERNAL_URL=http://127.0.0.1:4004

# PostgreSQL: credenciales distintas por dominio
DATABASE_URL=postgresql://luft_identity:password@localhost:5432/luft_db?schema=identity
IDENTITY_DATABASE_URL=postgresql://luft_identity:password@localhost:5432/luft_db?schema=identity
LUFT_DATABASE_URL=postgresql://luft_app:password@localhost:5432/luft_db?schema=luft
STARTIF_DATABASE_URL=postgresql://startif_app:password@localhost:5432/luft_db?schema=startif
AUDIT_DATABASE_URL=postgresql://luft_audit:password@localhost:5432/luft_db?schema=audit
SCORING_DATABASE_URL=postgresql://luft_scoring:password@localhost:5432/luft_db?schema=scoring
DATABASE_POOL_MAX=3
REDIS_URL=redis://luft:password@127.0.0.1:6379/5
REDIS_PREFIX=luft:

# Identidad propia
AUTH_SECRET=
COOKIE_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_SERVICE_TOKEN=
SESSION_COOKIE_NAME=luft_session
SESSION_TTL_DAYS=30
WEBAUTHN_RP_ID=luft.restaurar.co
WEBAUTHN_RP_NAME=LUFT
WEBAUTHN_ORIGIN=https://luft.restaurar.co

# Cuenta inicial de operación (se usa una sola vez con pnpm --filter @luft/api admin:create)
INITIAL_ADMIN_EMAIL=admin@luft.restaurar.co
INITIAL_ADMIN_USERNAME=luftadmin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=+573000000000
INITIAL_ADMIN_NAME="Administración LUFT"

# Integraciones: permanecen desactivadas hasta cargar credenciales reales
INTEGRATIONS_MODE=configuration_required
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
TRUORA_ENABLED=false
TRUORA_API_KEY=
TRUORA_ACCOUNT_ID=
TRUORA_FLOW_ID=
TRUORA_BASE_URL=https://api.identity.truora.com
TRUORA_START_ENDPOINT=/v1/processes
TRUORA_WEBHOOK_SECRET=
DATACREDITO_ENABLED=false
DATACREDITO_BASE_URL=
DATACREDITO_CLIENT_ID=
DATACREDITO_CLIENT_SECRET=
DATACREDITO_REPORT_ENDPOINT=
DATACREDITO_TRADELINE_ENDPOINT=
TRANSUNION_ENABLED=false
TRANSUNION_BASE_URL=
TRANSUNION_CLIENT_ID=
TRANSUNION_CLIENT_SECRET=
TRANSUNION_REPORT_ENDPOINT=
TRANSUNION_TRADELINE_ENDPOINT=
SMS_PROVIDER=configuration_required
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=LUFT
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="LUFT <hola@luft.restaurar.co>"
EVOLUTION_API_URL=https://evo.restaurar.co
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
N8N_BASE_URL=https://n8n.restaurar.co
N8N_ENABLED=false
N8N_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@luft.restaurar.co
PRIVATE_STORAGE_PATH=/var/www/luft/storage
LOG_LEVEL=info

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/audit"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CONFIGURATION_REQUIRED
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   String?  @db.VarChar(40)
  action      String   @db.VarChar(120)
  resource    String   @db.VarChar(100)
  resourceId  String?  @db.VarChar(160)
  ipHash      String?  @db.Char(64)
  userAgent   String?  @db.VarChar(500)
  payload     Json?
  previousHash String? @db.Char(64)
  eventHash   String   @unique @db.Char(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([resource, resourceId, createdAt])
}

model IntegrationEvent {
  id             String      @id @default(uuid()) @db.Uuid
  provider       String      @db.VarChar(60)
  operation      String      @db.VarChar(120)
  direction      String      @db.VarChar(16)
  status         EventStatus @default(PENDING)
  idempotencyKey String      @unique @db.VarChar(160)
  payloadHash    String?     @db.Char(64)
  httpStatus     Int?
  attempt        Int         @default(0)
  externalReference String?  @db.VarChar(160)
  errorCode      String?     @db.VarChar(100)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?   @db.Timestamptz(3)

  @@index([provider, status, createdAt])
}

model OutboxEvent {
  id          String      @id @default(uuid()) @db.Uuid
  topic       String      @db.VarChar(120)
  aggregateId String      @db.VarChar(160)
  payload     Json
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now()) @db.Timestamptz(3)
  processedAt DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
}

